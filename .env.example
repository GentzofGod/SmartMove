# ==============================================================================
# SmartMove — Environment Configuration Template
# Usage:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in your Cloud Supabase & Meta keys below
# 3. Run: flutter run --dart-define-from-file=.env
# ==============================================================================

# Cloud Supabase (Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Meta Developer App (App Settings > Basic)
META_APP_ID=your-meta-app-id
META_CLIENT_TOKEN=your-meta-client-token
